# Replace the project/log paths before installing this as a crontab entry.
# These jobs check provider metadata and clone HEADs; they do not apply source changes.
# Provider API keys (GLAMA_API_KEY, MCPMARKET_API_KEY, GITHUB_TOKEN) are read from the
# Git-ignored library.api.key at the project root when jobs run from the project directory,
# or from the process environment / a secret manager.

0 */6 * * * cd /absolute/path/to/mcp_library && /usr/bin/npm run providers:sync -- --limit 100 >> /var/log/mcp-library-provider-sync.log 2>&1
15 */6 * * * cd /absolute/path/to/mcp_library && /usr/bin/npm run library:refresh >> /var/log/mcp-library-provider-sync.log 2>&1
