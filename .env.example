# Copy to .env for local use only. Do not commit .env.
# Never paste a credential that has already been exposed in a chat, issue, URL, or commit.
#
# NOTE — provider API keys are centralized in ./library.api.key at the project root
# (Git-ignored; copy library.api.key.example to create it). The worker reads that file
# automatically for GLAMA_API_KEY, MCPMARKET_API_KEY, GITHUB_TOKEN, and the two
# provider base-URL overrides below. Keep only application secrets in .env;
# the variables below remain supported via the process environment (e.g. CI secrets).

# Local, Git-ignored location for registry snapshots and reviewed source clones.
# Root npm scripts default this to ./local-library. Use an absolute path in persistent deployments.
MCP_LIBRARY_HOME=

# Required when the PostgreSQL-backed catalog is enabled.
DATABASE_URL=

# Optional: raises public GitHub API quota for source enrichment.
# Use a NEW, minimum-scope token kept only in a local secret manager / deployment secret store.
GITHUB_TOKEN=

# Optional: Glama integration. providers:sync-glama reads GLAMA_API_KEY since Glama
# closed unauthenticated API access on 2026-08-26 — preferred location: ./library.api.key.
# Create a key at https://glama.ai/settings/api-keys and keep it only in a local
# secret manager / ./library.api.key / deployment secret store. Never paste a key into Git, chat, logs, or this template.
# API data use is governed by Glama's API Data License (visible attribution required when data is displayed).
GLAMA_API_KEY=
GLAMA_API_BASE_URL=https://glama.ai/api/mcp/v1

# Optional: MCPMarket integration. Preferred location: ./library.api.key.
# Do not paste a key into Git, chat, logs, or this committed template.
# An official MCPMarket API base URL/documentation is also required before an adapter can be enabled.
MCPMARKET_API_KEY=
MCPMARKET_API_BASE_URL=https://app.mcpmarket.com/api/v1

# Optional: semantic retrieval. The default uses no external embedding API.
EMBEDDING_PROVIDER=local
EMBEDDING_API_KEY=

# Required only when the protected curator area is enabled.
AUTH_SECRET=
AUTH_URL=http://localhost:3000
